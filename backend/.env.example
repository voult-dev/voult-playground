PORT=2000
VOULT_BASE_URL=   # optional, defaults to https://staging.voult.dev
VOULT_APP_URL=http://localhost:5173   # the playground frontend: OAuth sends users back here

VOULT_CLIENT_ID=
VOULT_CLIENT_SECRET=
VOULT_SESSION_SECRET=

# Optional: force the OAuth callback URL (e.g. behind a proxy). Default is computed from the request.
VOULT_OAUTH_CALLBACK_URL=

# Sign in with Google/GitHub/…: no provider keys here. Configure each provider in the
# Voult dashboard (your app → Sign-in providers) and add this server's callback,
# http://localhost:2000/api/auth/oauth/callback, under Callback URLs.
